<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI>
      <Dialog Height="270" Id="BHoMLicenseAgreementDlg" Title="!(loc.LicenseAgreementDlg_Title)" Width="370">
        <Control Height="44" Id="BannerBitmap" TabSkip="no" Text="!(loc.LicenseAgreementDlgBannerBitmap)" Type="Bitmap" Width="370" X="0" Y="0"></Control>
        <Control Height="0" Id="BannerLine" Type="Line" Width="370" X="0" Y="44"></Control>
        <Control Height="0" Id="BottomLine" Type="Line" Width="370" X="0" Y="234"></Control>
        <Control Height="15" Id="Description" NoPrefix="yes" Text="!(loc.LicenseAgreementDlgDescription)" Transparent="yes" Type="Text" Width="340" X="25" Y="23"></Control>
        <Control Height="15" Id="Title" NoPrefix="yes" Text="!(loc.LicenseAgreementDlgTitle)" Transparent="yes" Type="Text" Width="200" X="15" Y="6"></Control>
        <Control Height="17" Id="Print" Text="!(loc.WixUIPrint)" Type="PushButton" Width="56" X="112" Y="243">
          <Publish Property="DUMMY" Value="1" Condition="1" />
        </Control>
        <Control Height="17" Id="Back" Text="!(loc.WixUIBack)" Type="PushButton" Width="56" X="180" Y="243"></Control>
        <Control Default="yes" Height="17" Id="Next" Text="!(loc.WixUIAccept)" Type="PushButton" Width="56" X="236" Y="243">
          <Publish Property="WixUI_InstallMode" Value="InstallComplete" Condition="1" />
          <Publish Event="SetInstallLevel" Value="1000" Condition="1" />
          <Publish Event="SpawnWaitDialog" Value="WaitForCostingDlg" Condition="!(wix.WixUICostingPopupOptOut) OR CostingComplete = 1" />
        </Control>
        <Control Cancel="yes" Height="17" Id="Cancel" Text="!(loc.WixUICancel)" Type="PushButton" Width="56" X="304" Y="243">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1" />
        </Control>
        <Control Height="165" Id="LicenseText" Sunken="yes" TabSkip="no" Type="ScrollableText" Width="330" X="20" Y="60">
          <Text SourceFile="!(wix.WixUILicenseRtf)"></Text>
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
