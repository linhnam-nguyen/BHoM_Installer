<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Fragment>
    <!-- Manual groups for extra logic -->
    <ComponentGroup Directory="ASSEMBLIESDIR" Id="Excel">
      <!-- Logic for Excel if any (registry keys etc. are in InstallerCA) -->
    </ComponentGroup>

    <ComponentGroup Directory="GRASSHOPPERPLUGINDIR" Id="Grasshopper">
      <Component Id="GHA" Guid="{A1EE1994-996D-4AF2-B61E-DA5C910534CC}">
        <CreateFolder />
        <util:RemoveFolderEx On="install" Property="GHBHoMFolder"></util:RemoveFolderEx>
      </Component>
    </ComponentGroup>

    <ComponentGroup Directory="R2022DIR" Id="Revit2022">
      <Component Id="RevitAddin2022" Guid="{8B32B669-D0A4-4A3C-8A95-6548B8E8E922}">
        <CreateFolder />
        <util:RemoveFolderEx On="install" Property="R2022BHoMFolder"></util:RemoveFolderEx>
        <RemoveFile Id="RemoveLegacyAddin22" Name="BHoM.Addin" On="install"></RemoveFile>
      </Component>
    </ComponentGroup>

    <ComponentGroup Directory="R2023DIR" Id="Revit2023">
      <Component Id="RevitAddin2023" Guid="{3A4B8F3C-9E7A-4B6E-B58A-65D9C4A1F8F3}">
