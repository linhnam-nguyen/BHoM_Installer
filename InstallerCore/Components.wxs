    <ComponentGroup Directory="INSTALLFOLDER" Id="Core">
      <Component Id="CleanExisting" Guid="{F1B2C3D4-E5F6-4A5B-8C9D-E1F2A3B4C5D6}">
        <RegistryKey Key="Software\BHoM" Root="HKCU">
          <RegistryValue Name="Installer" Type="integer" Value="1"></RegistryValue>
        </RegistryKey>
        <util:RemoveFolderEx On="both" Property="ASSEMBLIESDIR"></util:RemoveFolderEx>
        <util:RemoveFolderEx On="both" Property="GRASSHOPPERPLUGINDIR"></util:RemoveFolderEx>
        <util:RemoveFolderEx On="both" Property="FILESDIR"></util:RemoveFolderEx>
        <util:RemoveFolderEx On="both" Property="UPGRADESDIR"></util:RemoveFolderEx>
        <util:RemoveFolderEx On="both" Property="OLDINSTALLFOLDER"></util:RemoveFolderEx>
      </Component>
    </ComponentGroup>

    <ComponentGroup Directory="SETTINGSDIR" Id="SettingsConfig">
      <Component Guid="00380245-6e1f-4896-9e46-0d87a72f75ad" Id="SettingsConfig">
        <File Source="..\Settings\IncludedDLLs.txt"></File>
        <File Source="..\Settings\IncludedDatasets.txt"></File>
