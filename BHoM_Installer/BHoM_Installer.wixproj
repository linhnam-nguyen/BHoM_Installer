<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <MajorVersion Condition=" '$(MajorVersion)' == '' ">9</MajorVersion>
    <MinorVersion Condition=" '$(MinorVersion)' == '' ">0</MinorVersion>
    <VersionSuffix></VersionSuffix>
    <ProductVersion>$(MajorVersion).$(MinorVersion)</ProductVersion>
    <EnableProjectHarvesting>True</EnableProjectHarvesting>
    <ReleaseType Condition=" '$(ReleaseType)' == '' ">alpha</ReleaseType>
    <ReleaseVersion Condition=" '$(ReleaseType)' == 'alpha' ">0</ReleaseVersion>
    <ReleaseVersion Condition=" '$(ReleaseType)' == 'beta' ">1</ReleaseVersion>
    <ReleaseVersion Condition=" '$(ReleaseVersion)' == '' ">0</ReleaseVersion>
    <PatchVersion Condition=" '$(PatchVersion)' == '' ">0</PatchVersion>
    <WixProductVersion>$(ProductVersion).$(ReleaseVersion).$(PatchVersion)</WixProductVersion>
    <OutputPath>..\Build\</OutputPath>
    <DefineConstants>Version=$(WixProductVersion)</DefineConstants>
    <SuppressIces>ICE64;ICE38;ICE91;ICE17</SuppressIces>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <DefineConstants>Debug;$(DefineConstants)</DefineConstants>
    <SuppressAllWarnings>False</SuppressAllWarnings>
    <Pedantic>False</Pedantic>
    <SuppressValidation>False</SuppressValidation>
    <SuppressIces>ICE64;ICE38;ICE91;ICE17</SuppressIces>
    <Cultures>en-US</Cultures>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <DefineConstants>Version=$(WixProductVersion);$(DefineConstants)</DefineConstants>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
    <Cultures>en-US</Cultures>
  </PropertyGroup>
  <PropertyGroup>
    <OutputName>$(PatchVersion)_BHoM_v$(ProductVersion).$(ReleaseType)</OutputName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\InstallerCA\InstallerCA.csproj">
      <Name>InstallerCA</Name>
      <Project>{f135d7b8-747c-4c4f-a9fc-1f3a25fbd403}</Project>
      <Private>True</Private>
      <DoNotHarvest>True</DoNotHarvest>
      <RefProjectOutputGroups>Binaries;Content;Satellites</RefProjectOutputGroups>
      <RefTargetDir>INSTALLFOLDER</RefTargetDir>
    </ProjectReference>
    <ProjectReference Include="..\InstallerCore\InstallerCore.wixproj">
      <Name>InstallerCore</Name>
      <Project>{9269f4f2-f136-46a8-9ba2-4899c5ca38d3}</Project>
      <Private>True</Private>
      <DoNotHarvest>True</DoNotHarvest>
      <RefProjectOutputGroups>Binaries;Content;Satellites</RefProjectOutputGroups>
      <RefTargetDir>INSTALLFOLDER</RefTargetDir>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Heat" Version="6.0.2" />
  </ItemGroup>

  <Target Name="CleanupStagedFiles" AfterTargets="AfterBuild">
    <PropertyGroup>
      <StagingBase>$(MSBuildProjectDirectory)\..\InstallerCore\</StagingBase>
    </PropertyGroup>
    <ItemGroup>
      <CleanupDirs Include="$(StagingBase)Assemblies;$(StagingBase)Upgrades;$(StagingBase)DataSets;$(StagingBase)Extensions;$(StagingBase)Resources;$(StagingBase)GrasshopperPlugin;$(StagingBase)ExcelPlugin;$(StagingBase)Revit" />
    </ItemGroup>
    <RemoveDir Directories="@(CleanupDirs)" />
  </Target>
</Project>